{
  "manifest_version": 3,
  "name": "Ambient Light for Videos",
  "version": "1.0.0",
  "description": "Adds a soft, colour-matched glow around any video you play. Hides itself in fullscreen.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Ambient Light",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
